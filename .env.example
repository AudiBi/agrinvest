# Copier en .env (jamais versionné) et renseigner les valeurs.
# Variables OBLIGATOIRES en production : le démarrage échoue sans elles.
FLASK_ENV=production
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=          # postgresql://user:motdepasse@hote:5432/agrinvest
POSTGRES_PASSWORD=     # utilisé par docker-compose.yml
BASE_URL=https://agrinvest.ht
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://agrinvest.ht
REDIS_URL=redis://redis:6379/0   # limitation de débit, cache, Celery

# --- Paiements (obligatoires pour accepter de l'argent) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=           # endpoint : /api/v1/payments/webhook/stripe
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live                 # sandbox pour les tests
PAYPAL_WEBHOOK_ID=               # endpoint : /api/v1/payments/webhook/paypal
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_ENVIRONMENT=production   # sandbox pour les tests
MONCASH_API_URL=
MONCASH_WEBHOOK_SECRET=          # endpoint : /api/v1/webhooks/moncash (en-tête X-MonCash-Signature)

# --- Email, taux de change, suivi d'erreurs ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
EXCHANGE_RATE_API_KEY=
SENTRY_DSN=

# --- Optionnel ---
JWT_SECRET_KEY=                  # sinon SECRET_KEY
LOG_LEVEL=WARNING

# --- Politique de la plateforme ---
REQUIRE_PROJECT_APPROVAL=false   # true : un projet soumis attend la validation d'un administrateur
CONTACT_EMAIL=                   # destinataire du formulaire de contact (sinon MAIL_DEFAULT_SENDER)
# Premier administrateur : `docker compose run --rm web flask --app wsgi create-admin`
# (ou AGRINVEST_ADMIN_PASSWORD pour un déploiement automatisé ; ne jamais le laisser dans .env ensuite)
